    <mxGraphModel dx="1489" dy="891" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cfg_A_by_level-1" value="&lt;font style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;CONFIGURATION 18_6_8 — Level Parameters&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="8" width="1360" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-2" value="&lt;font style=&quot;font-size:13px;color:#555555&quot;&gt;Global defines on top, followed by L1 / L2 / L3 columns: DEFINES → STATISTICS → PARAMETERS.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="42" width="1360" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-3" value="DEFINES — user-defined constants" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="20" y="72" width="250" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-4" value="STATISTICS — derived from routing prefix table" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="72" width="340" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-5" value="PARAMETERS — calculated from formulas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="630" y="72" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-6" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;GLOBAL DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;Configuration 18_6_8:&lt;/font&gt;&lt;br&gt;port_size = 8 bits &amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp; pc_chunk_size = 8*8 = 64 bits &amp;nbsp;(chunk [63:0])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="110" width="1360" height="86" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-7" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;L1&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="210" width="440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-8" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l1_ip_size = 18&lt;br&gt;l1_pc_count = 1&lt;br&gt;l1_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="254" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-9" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L1 seq array size: l1_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="364" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-10" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;br&gt;l1_ch_sum_size = (2^18 / pc_chunk_size) * 1 = 2^12 cells&lt;br&gt;l1_seq_cell = 18 bits&lt;br&gt;&lt;br&gt;&lt;b&gt;Bus Width Parameters (bits):&lt;/b&gt;&lt;br&gt;l1_seq_bus = $clog2(l1_seq_size)&lt;br&gt;l1_word_bus = 12&lt;br&gt;&lt;br&gt;&lt;b&gt;L1 BRAM Cell sizes:&lt;/b&gt;&lt;br&gt;popcount: 64 bit &amp;nbsp;|&amp;nbsp; seq array: 18 bit &amp;nbsp;|&amp;nbsp; chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="464" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-11" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (1 bit flag + 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l1\_seq\_cell} = 9\left\lceil \frac{1+\max(\lceil\log_2(\text{l2\_pc\_count})\rceil, \text{port\_size})}{9} \right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[ \text{l1\_seq\_cell} = 9\left\lceil \frac{1+\max(\lceil\log_2(\text{l2\_pc\_count})\rceil, \text{port\_size})}{9} \right\rceil \]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="736" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-12" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;L2&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="480" y="210" width="440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-13" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l2_ip_size = 6&lt;br&gt;l2_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="480" y="254" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-14" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L2 popcount blocks: l2_pc_count&lt;br&gt;L2 seq array size: l2_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="480" y="364" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-15" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;br&gt;l2_ch_sum_size = (2^6 / pc_chunk_size) * l2_pc_count = l2_pc_count cells&lt;br&gt;l2_seq_cell = 9 bits&lt;br&gt;&lt;br&gt;&lt;b&gt;Bus Width Parameters (bits):&lt;/b&gt;&lt;br&gt;l2_seq_bus = $clog2(l2_seq_size)&lt;br&gt;l2_pc_bus = $clog2(l2_pc_count)&lt;br&gt;l2_word_bus = l2_pc_bus&lt;br&gt;&lt;br&gt;&lt;b&gt;L2 BRAM Cell sizes:&lt;/b&gt;&lt;br&gt;popcount: 64 bit &amp;nbsp;|&amp;nbsp; seq array: 9 bit &amp;nbsp;|&amp;nbsp; chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="480" y="464" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-16" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (1 bit flag + 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l2\_seq\_cell} = 9\left\lceil \frac{1+\max(\lceil\log_2(\text{l3\_pc\_count})\rceil, \text{port\_size})}{9} \right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[ \text{l2\_seq\_cell} = 9\left\lceil \frac{1+\max(\lceil\log_2(\text{l3\_pc\_count})\rceil, \text{port\_size})}{9} \right\rceil \]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="480" y="736" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-17" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;L3&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="940" y="210" width="440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-18" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l3_ip_size = 8&lt;br&gt;l3_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="940" y="254" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-19" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L3 popcount blocks: l3_pc_count&lt;br&gt;L3 seq array size: l3_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="940" y="364" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-20" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;br&gt;l3_ch_sum_size = (2^8 / pc_chunk_size) * l3_pc_count = 4 * l3_pc_count cells&lt;br&gt;l3_seq_cell = 9 bits&lt;br&gt;&lt;br&gt;&lt;b&gt;Bus Width Parameters (bits):&lt;/b&gt;&lt;br&gt;l3_seq_bus = $clog2(l3_seq_size)&lt;br&gt;l3_pc_bus = $clog2(l3_pc_count)&lt;br&gt;l3_word_bus = l3_pc_bus + 2&lt;br&gt;&lt;br&gt;&lt;b&gt;L3 BRAM Cell sizes:&lt;/b&gt;&lt;br&gt;popcount: 64 bit &amp;nbsp;|&amp;nbsp; seq array: 9 bit &amp;nbsp;|&amp;nbsp; chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="940" y="464" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-21" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (no flag, 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l3\_seq\_cell} = 9\left\lceil \frac{\text{port\_size}}{9} \right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[ \text{l3\_seq\_cell} = 9\left\lceil \frac{\text{port\_size}}{9} \right\rceil \]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="940" y="736" width="440" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="datapath" id="Zd6u88xbrfHAsg1tblmn">
    <mxGraphModel dx="4168" dy="2496" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="2808" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dp1" value="&lt;font style=&quot;font-size:22px;color:#cc0000&quot;&gt;&lt;b&gt;RTL DATAPATH — Configuration 18_6_8&lt;/b&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=22;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="8" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dp2" value="&lt;font style=&quot;color:#555555&quot;&gt;Combinational datapath: true bus widths and bit ranges, zero-latency BRAM view (no pipeline registers). Parameter names match the configuration sheet.&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=13;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="44" width="1900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="dp3" value="popcount: chunk [63:0] = 64-bit BRAM cell" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="80" width="270" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp4" value="chunk_sums: cell [17:0] (18 bit)" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="80" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp5" value="seq array: cell lN_seq_cell" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="510" y="80" width="230" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp6" value="selected cell" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="750" y="80" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp7" value="logic / adder" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="910" y="80" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp8" value="thick line = multi-bit bus (width in label), thin = 1 bit" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1070" y="80" width="450" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp9" value="&lt;b&gt;Conventions &amp;amp; Architecture Notes&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Popcount BRAM:&lt;/b&gt; sequence of 64-bit chunks &lt;b&gt;[63:0]&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– &lt;b&gt;L1:&lt;/b&gt; 1 block = 2^12 chunks (2^18 bits total)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– &lt;b&gt;L2:&lt;/b&gt; l2_pc_count blocks × 1 chunk (64 bits per block)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– &lt;b&gt;L3:&lt;/b&gt; l3_pc_count blocks × 4 chunks (256 bits per block)&lt;br&gt;• &lt;b&gt;Address calculation:&lt;/b&gt; &lt;b&gt;seq_addr = chunk_sum + offset&lt;/b&gt; &amp;nbsp;(the -1 index shift is pre-baked into table build)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– &lt;b&gt;chunk_sum [17:0]:&lt;/b&gt; cumulative 1-bits before the current chunk&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;– &lt;b&gt;offset [6:0]:&lt;/b&gt; number of 1-bits in the current chunk within &lt;b&gt;[0..bit_pos]&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Sequence cell format:&lt;/b&gt; MSB is &lt;b&gt;is_ptr&lt;/b&gt; (1 = next-level pointer, 0 = output port ID). L3 has no flag: &lt;b&gt;port = cell[7:0]&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;Bus widths:&lt;/b&gt; &lt;b&gt;lN_seq_bus&lt;/b&gt;, &lt;b&gt;l2_pc_bus&lt;/b&gt;, &lt;b&gt;l3_pc_bus&lt;/b&gt;, &lt;b&gt;l3_word_bus&lt;/b&gt; are bit-width parameters from the &lt;b&gt;configuration&lt;/b&gt; sheet." style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="20" y="114" width="1100" height="172" as="geometry" />
        </mxCell>
        <mxCell id="dp10" value="&lt;b&gt;L1&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="300" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dp12" value="&lt;b&gt;L1 ADDR&lt;/b&gt;&lt;br&gt;l1_idx = ip[31:14] &amp;nbsp;(18 bit)&lt;br&gt;l1_word_addr = l1_idx[17:6] &amp;nbsp;(12 bit)&lt;br&gt;l1_bit_pos = l1_idx[5:0] &amp;nbsp;(6 bit)" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=3;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="140" y="400" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dp13" value="&lt;b&gt;L1 POPCOUNT BRAM&lt;/b&gt;&lt;br&gt;2^12 cells × [63:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="450" y="380" width="284" height="222" as="geometry" />
        </mxCell>
        <mxCell id="dp14" value="&lt;b&gt;L1 CHUNK_SUMS BRAM&lt;/b&gt;&lt;br&gt;2^12 cells × [17:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="770" y="380" width="180" height="222" as="geometry" />
        </mxCell>
        <mxCell id="dp15" value="popcount_0&lt;br&gt;2^12 chunks&lt;br&gt;(2^18 bits)" style="whiteSpace=wrap;html=1;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="458" y="425" width="90" height="166" as="geometry" />
        </mxCell>
        <mxCell id="dp16" value="chunk 0 [63:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="425" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp17" value="sum 0 [17:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="778" y="425" width="164" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp18" value="chunk 1 [63:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="453" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp19" value="sum 1 [17:0]" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="778" y="453" width="164" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp20" value="…" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="481" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp21" value="…" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="778" y="481" width="164" height="26" as="geometry" />
        </mxCell>
