        <mxCell id="I3tQiWn1K8ykOPhhGTVz-2" value="&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;seq_array cell sizes ( 1 bit flag and 9 bit align):&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l1\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l1\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l2\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l2\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l3\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{\text{port\_size}}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l3\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{\text{port\_size}}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
