        <mxCell id="HUOoPBsaZyw_0_vDypMt-175" value="&lt;div&gt;&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;font style=&quot;font-size: 20px; color: rgb(204, 0, 0); line-height: 130%;&quot;&gt;DEFINES&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;Configuration 18_6_8:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp; l1_ip_size = 18&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l2_ip_size = 6&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l3_ip_size = 8&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;port_size = 8 bits&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;popcount chunk size:&lt;/font&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;pc_chunk_size = 8*8 = 64 bits&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;chunk_sums cell&lt;/font&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 130%;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 16px; line-height: 130%;&quot;&gt;sizes:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px; line-height: 130%;&quot;&gt;l1_ch_sum_cell = 2*9 = 18 bits&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l2_ch_sum_cell =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;2*9 = 18&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;bits&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l3_ch_sum_cell =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;2*9 = 18&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;bits&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
