        <mxCell id="QVHe-7D58XBj0k6HdABC-5" value="&lt;div&gt;&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;font style=&quot;font-size: 20px; color: rgb(204, 0, 0); line-height: 130%;&quot;&gt;DEFINES&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;Configuration 18_6_8:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp; l1_ip_size = 18&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l2_ip_size = 6&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l3_ip_size = 8&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;port_size = 8 bits&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;popcount chunk size:&lt;/font&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;pc_chunk_size = 8*8 = 64 bits&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; line-height: 130%;&quot;&gt;chunk_sums cell&lt;/font&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 130%;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 16px; line-height: 130%;&quot;&gt;sizes:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px; line-height: 130%;&quot;&gt;l1_ch_sum_cell = 2*9 = 18 bits&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l2_ch_sum_cell =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;2*9 = 18&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;bits&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;l3_ch_sum_cell =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;2*9 = 18&lt;/span&gt;&lt;span style=&quot;font-size: 14px; line-height: 130%;&quot;&gt;&amp;nbsp;bits&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="220" height="310" as="geometry" />
        </mxCell>
        <mxCell id="QVHe-7D58XBj0k6HdABC-6" value="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;L1/L2/L3&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Byte sizes&lt;/font&gt;&lt;div&gt;&lt;font&gt;popcount: 8 bit&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;seq array: 9 bit&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;chunk sums: 9 bit&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="QVHe-7D58XBj0k6HdABC-7" value="&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;seq_array cell sizes ( 1 bit flag and 9 bit align):&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l1\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l1\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l2\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l2\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-math-source=&quot;\text{l3\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{\text{port\_size}}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l3\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{\text{port\_size}}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
