  <diagram id="cfgtStXwE6wbqSXnuOift" name="configuration">
    <mxGraphModel dx="1895" dy="1135" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cfg_A_by_level-1" value="&lt;font style=&quot;font-size:22px;&quot;&gt;CONFIGURATION 18_6_8 — параметры по уровням&lt;/font&gt;&lt;b&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="8" width="1240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-2" value="&lt;font style=&quot;font-size:13px;color:#555555&quot;&gt;Общие параметры сверху, затем колонки L1 / L2 / L3: DEFINES → STATISTICS → PARAMETERS.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="42" width="1240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-3" value="DEFINES — задаём сами" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="20" y="72" width="215" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-4" value="STATISTICS — из статистики по таблице префиксов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="245" y="72" width="380" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-5" value="PARAMETERS — считаются по формулам" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="635" y="72" width="285" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-6" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;DEFINES (общие)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;Configuration 18_6_8:&lt;/font&gt;&lt;br&gt;port_size = 8 bits &amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp; pc_chunk_size = 8*8 = 64 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="110" width="1240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-7" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;L1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="20" y="210" width="400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-8" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l1_ip_size = 18&lt;br&gt;L1 popcount: 1&lt;br&gt;l1_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="254" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-9" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L1 seq array size: l1_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="364" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-10" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l1_ch_sum_size = 2^18 / pc_chunk_size * 1&lt;br&gt;&amp;nbsp;= 2^12 cells&lt;br&gt;l1_seq_cell = 18 bits&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;L1 BRAM Cell sizes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;popcount: 64 bit&lt;br&gt;seq array: 18 bit&lt;br&gt;chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="464" width="400" height="232" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-11" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (1 bit flag + 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l1\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l1\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l2\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="706" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-12" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;L2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="440" y="210" width="400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-13" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l2_ip_size = 6&lt;br&gt;l2_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="440" y="254" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-14" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L2 popcount: l2_pc_count&lt;br&gt;L2 seq array size: l2_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="440" y="364" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-15" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l2_ch_sum_size = 2^6 / pc_chunk_size * l2_pc_count&lt;br&gt;&amp;nbsp;= l2_pc_count cells&lt;br&gt;l2_seq_cell = 9 bits&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;L2 BRAM Cell sizes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;popcount: 64 bit&lt;br&gt;seq array: 9 bit&lt;br&gt;chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="440" y="464" width="400" height="232" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-16" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (1 bit flag + 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l2\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{1+\max(&amp;lt;br/&amp;gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&amp;lt;br/&amp;gt;\text{port\_size}&amp;lt;br/&amp;gt;)}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l2\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{1+\max(&lt;br&gt;\lceil\log_2(\text{l3\_seq\_size})\rceil,&lt;br&gt;\text{port\_size}&lt;br&gt;)}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="440" y="706" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-17" value="&lt;font style=&quot;font-size:20px;color: rgb(204, 0, 0);&quot;&gt;L3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="860" y="210" width="400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-18" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DEFINES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l3_ip_size = 8&lt;br&gt;l3_ch_sum_cell = 2*9 = 18 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="860" y="254" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-19" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;STATISTICS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L3 popcount: l3_pc_count&lt;br&gt;L3 seq array size: l3_seq_size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="860" y="364" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-20" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;chunk_sum array size (cells count):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;l3_ch_sum_size = 2^8 / pc_chunk_size * l3_pc_count&lt;br&gt;&amp;nbsp;= 4 * l3_pc_count cells&lt;br&gt;l3_seq_cell = 9 bits&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;L3 BRAM Cell sizes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;popcount: 64 bit&lt;br&gt;seq array: 9 bit&lt;br&gt;chunk sums: 18 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="860" y="464" width="400" height="232" as="geometry" />
        </mxCell>
        <mxCell id="cfg_A_by_level-21" value="&lt;font style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;seq_array cell size (1 bit flag + 9 bit align):&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span data-math-source=&quot;\text{l3\_seq\_cell} =&amp;lt;br/&amp;gt;9\left\lceil&amp;lt;br/&amp;gt;\frac{\text{port\_size}}{9}&amp;lt;br/&amp;gt;\right\rceil&quot; data-math-display=&quot;true&quot;&gt;\[&lt;br&gt;\text{l3\_seq\_cell} =&lt;br&gt;9\left\lceil&lt;br&gt;\frac{\text{port\_size}}{9}&lt;br&gt;\right\rceil&lt;br&gt;\]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="860" y="706" width="400" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dpf4B15bfhnLeamIo5sT" name="datapath">
    <mxGraphModel dx="1226" dy="734" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="2808" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dp1" value="&lt;font style=&quot;font-size:22px;color:#cc0000&quot;&gt;RTL DATAPATH — конфигурация 18_6_8&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=22;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="8" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dp2" value="&lt;font style=&quot;color:#555555&quot;&gt;Комбинационная схема: реальные шины и размеры, без задержек BRAM и без регистров. Имена параметров — из листа configuration.&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=13;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="44" width="1900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="dp3" value="popcount: чанк = ячейка BRAM 64 bit" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="20" y="80" width="270" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp4" value="chunk_sums: ячейка 18 bit" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="80" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp5" value="seq array: ячейка lN_seq_cell" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="510" y="80" width="230" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp6" value="выбранная ячейка" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="750" y="80" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp7" value="логика / сумматор" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="910" y="80" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp8" value="жирная линия = шина (ширина в подписи), тонкая = 1 бит" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1070" y="80" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp9" value="&lt;b&gt;Соглашения&lt;/b&gt;&lt;br&gt;• popcount уровня = последовательность чанков, чанк = одна ячейка BRAM (pc_chunk_size = 64 bit). L1: один popcount из 2^12 чанков. L2: popcount = 1 чанк (2^6 / 64). L3: popcount = 4 чанка (2^8 / 64).&lt;br&gt;• chunk_sum = число единиц bitmap уровня до этого чанка (по всему уровню). offset = число единиц в чанке на позициях [0..bit_pos] включительно. seq_addr = chunk_sum + offset. Сдвиг на 1 учитывается при построении таблиц.&lt;br&gt;• Старший бит seq-ячейки = is_ptr (1 = PTR на popcount следующего уровня, 0 = PORT). У L3 флага нет: port = cell[7:0].&lt;br&gt;• $clog2(...) — размеры из статистики (l2_pc_count, l3_pc_count, lN_seq_size). Остальные ширины — реальные для 18_6_8." style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=3;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="20" y="118" width="1900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dp10" value="&lt;b&gt;L1&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;fontSize=16;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="300" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dp11" value="l1_ip_size = 18 · L1 popcount: 1 · 2^18 / pc_chunk_size = 2^12 чанков в одном popcount" style="whiteSpace=wrap;html=1;rounded=0;fontSize=12;fillColor=none;strokeColor=none;align=left;spacingLeft=3;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="230" y="300" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dp12" value="&lt;b&gt;L1 ADDR&lt;/b&gt;&lt;br&gt;l1_idx = ip[31:14]  (l1_ip_size = 18)&lt;br&gt;chunks per popcount = 2^18 / 64 = 2^12&lt;br&gt;l1_word_addr = l1_idx[17:6]  (12 bit)&lt;br&gt;l1_bit_pos = l1_idx[5:0]  (6 bit)" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=3;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="140" y="400" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dp13" value="&lt;b&gt;L1 POPCOUNT BRAM&lt;/b&gt; (× 64 bit)&lt;br&gt;l1_ch_sum_size = 2^12 cells" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="450" y="380" width="284" height="222" as="geometry" />
        </mxCell>
        <mxCell id="dp14" value="&lt;b&gt;L1 CHUNK_SUMS BRAM&lt;/b&gt;&lt;br&gt;2^12 cells × 18 bit" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=top;spacingTop=3;" parent="1" vertex="1">
          <mxGeometry x="770" y="380" width="180" height="222" as="geometry" />
        </mxCell>
        <mxCell id="dp15" value="popcount&lt;br&gt;(L1 popcount: 1)&lt;br&gt;2^12 чанков&lt;br&gt;= 2^18 bit" style="whiteSpace=wrap;html=1;rounded=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="458" y="425" width="90" height="166" as="geometry" />
        </mxCell>
        <mxCell id="dp16" value="chunk 0" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="425" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp17" value="sum 0" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="778" y="425" width="164" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp18" value="chunk 1" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="453" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp19" value="sum 1" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="778" y="453" width="164" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp20" value="…" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="552" y="481" width="174" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dp21" value="…" style="whiteSpace=wrap;html=1;rounded=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="1" vertex="1">
