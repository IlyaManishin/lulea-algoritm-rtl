        <mxCell id="I3tQiWn1K8ykOPhhGTVz-1" value="&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;L1/L2/L3&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Byte sizes&lt;/font&gt;&lt;div&gt;&lt;font&gt;popcount: 8 bit&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;seq array: 9 bit&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;chunk sums: 9 bit&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#36393d;" parent="1" vertex="1">
